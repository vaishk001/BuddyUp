rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - anyone authenticated can read, users can write their own data
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      
      // Friend requests subcollection
      match /friendRequests/{requestId} {
        allow read, write: if request.auth != null;
      }
    }

    // Chats collection - any authenticated user can read/write
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Stories collection - anyone authenticated can read, users can write/delete their own stories
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Calls collection - participants can read/write call data
    match /calls/{callId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      
      // ICE candidates subcollection
      match /candidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}

