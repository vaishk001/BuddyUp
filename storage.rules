rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload files
    match /images/{allPaths=**} {
      allow read: if true; // Anyone can read images
      allow write: if request.auth != null 
                   && request.resource.size < 10 * 1024 * 1024 // Max 10MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    match /videos/{allPaths=**} {
      allow read: if true; // Anyone can read videos
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024 // Max 100MB
                   && request.resource.contentType.matches('video/.*');
    }
    
    match /audio/{allPaths=**} {
      allow read: if true; // Anyone can read audio
      allow write: if request.auth != null 
                   && request.resource.size < 50 * 1024 * 1024 // Max 50MB
                   && request.resource.contentType.matches('audio/.*');
    }

    // Voice message recordings (webm/opus or other audio containers)
    match /voice-messages/{allPaths=**} {
      allow read: if true; // Allow playback for all
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024 // Max 20MB per voice message
                   && (
                        request.resource.contentType.matches('audio/.*') ||
                        request.resource.contentType == 'application/octet-stream'
                      );
    }
    
    match /documents/{allPaths=**} {
      allow read: if request.auth != null; // Only authenticated users can read documents
      allow write: if request.auth != null 
                   && request.resource.size < 100 * 1024 * 1024; // Max 100MB
    }
  }
}
